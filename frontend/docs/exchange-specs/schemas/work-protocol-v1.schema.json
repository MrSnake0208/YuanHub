{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YuanHub Work Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "game",
    "stage_name",
    "doc",
    "operators",
    "rounds"
  ],
  "properties": {
    "format": {
      "const": "yuanhub-work"
    },
    "version": {
      "const": 1
    },
    "game": {
      "enum": [
        "代号鸢",
        "如鸢"
      ]
    },
    "level_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stage_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "doc": {
      "$ref": "#/$defs/doc"
    },
    "operators": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/operatorSlot" },
        { "$ref": "#/$defs/operatorSlot" },
        { "$ref": "#/$defs/operatorSlot" },
        { "$ref": "#/$defs/operatorSlot" },
        { "$ref": "#/$defs/operatorSlot" }
      ],
      "items": false
    },
    "exec": {
      "$ref": "#/$defs/exec"
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/round"
      }
    }
  },
  "$defs": {
    "doc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "details"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "details": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "operatorSlot": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "exec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delays_ms": {
          "$ref": "#/$defs/delays"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "delays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attack": {
          "$ref": "#/$defs/delayMs"
        },
        "ultimate": {
          "$ref": "#/$defs/delayMs"
        },
        "defense": {
          "$ref": "#/$defs/delayMs"
        },
        "sp": {
          "$ref": "#/$defs/delayMs"
        }
      }
    },
    "delayMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maayuan": {
          "$ref": "#/$defs/maayuanExtension"
        },
        "yuanassist": {
          "$ref": "#/$defs/yuanassistExtension"
        }
      }
    },
    "maayuanExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level_type": {
          "enum": [
            "主线",
            "洞窟",
            "活动",
            "活动有分级",
            "白鹄",
            "兰台",
            "其他"
          ]
        },
        "recognition_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rec_target_offset": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "integer" },
            { "type": "integer" },
            { "type": "integer" },
            { "type": "integer" }
          ],
          "items": false
        },
        "difficulty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cave_type": {
          "enum": [
            "左",
            "右"
          ]
        },
        "lantai_nav": {
          "type": "boolean"
        }
      }
    },
    "yuanassistExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enemy_turn_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "actions"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "remark": {
          "type": "string",
          "maxLength": 2000
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/slotAction" },
        { "$ref": "#/$defs/waitAction" },
        { "$ref": "#/$defs/pauseAction" },
        { "$ref": "#/$defs/switchTargetAction" },
        { "$ref": "#/$defs/autoBattleAction" },
        { "$ref": "#/$defs/interactionAction" },
        { "$ref": "#/$defs/operatorAction" },
        { "$ref": "#/$defs/checkAction" },
        { "$ref": "#/$defs/restartAction" }
      ]
    },
    "slotAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "type"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "type": {
          "enum": [
            "attack",
            "ultimate",
            "defense",
            "sp"
          ]
        }
      }
    },
    "waitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "duration_ms"
      ],
      "properties": {
        "type": {
          "const": "wait"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      }
    },
    "pauseAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "pause"
        }
      }
    },
    "switchTargetAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "direction"
      ],
      "properties": {
        "type": {
          "const": "switch_target"
        },
        "direction": {
          "enum": [
            "left",
            "right"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        }
      }
    },
    "autoBattleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "enabled"
      ],
      "properties": {
        "type": {
          "const": "auto_battle"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "interactionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "interaction"
        }
      }
    },
    "operatorAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slot",
        "action"
      ],
      "properties": {
        "type": {
          "const": "operator_action"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "action": {
          "enum": [
            "switch_form"
          ]
        }
      }
    },
    "checkAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "condition",
        "on_fail"
      ],
      "properties": {
        "type": {
          "const": "check"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "on_fail": {
          "enum": [
            "restart",
            "stop",
            "pause"
          ]
        }
      }
    },
    "restartAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "restart"
        }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/partySurvivesCondition" },
        { "$ref": "#/$defs/operatorAliveCondition" },
        { "$ref": "#/$defs/operatorPresentCondition" },
        { "$ref": "#/$defs/operatorCopiedCondition" },
        { "$ref": "#/$defs/dragonQiCondition" },
        { "$ref": "#/$defs/starCountCondition" },
        { "$ref": "#/$defs/critCondition" }
      ]
    },
    "partySurvivesCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "party_survives"
        }
      }
    },
    "operatorAliveCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slot"
      ],
      "properties": {
        "type": {
          "const": "operator_alive"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        }
      }
    },
    "operatorPresentCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slot"
      ],
      "properties": {
        "type": {
          "const": "operator_present"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        }
      }
    },
    "operatorCopiedCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slot"
      ],
      "properties": {
        "type": {
          "const": "operator_copied"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        }
      }
    },
    "comparisonOperator": {
      "enum": [
        "<",
        "<=",
        "=",
        ">=",
        ">"
      ]
    },
    "dragonQiCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "operator",
        "value"
      ],
      "properties": {
        "type": {
          "const": "dragon_qi"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "operator": {
          "$ref": "#/$defs/comparisonOperator"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      }
    },
    "starCountCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "color",
        "operator",
        "value"
      ],
      "properties": {
        "type": {
          "const": "star_count"
        },
        "color": {
          "enum": [
            "orange",
            "purple",
            "blue"
          ]
        },
        "operator": {
          "$ref": "#/$defs/comparisonOperator"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "critCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "crit"
        }
      }
    }
  }
}
