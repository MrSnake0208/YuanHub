{
  "name": "yuanhub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "YuanHub 鸢鸢相抱 · 由 Vite + Vue 3 复刻",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "VITE_API_BASE= vite --mode tunnel",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:behavior": "vitest run",
    "test:property": "node --test test/property/*.test.js",
    "test:static": "node scripts/check-source.mjs",
    "test:all": "npm run test:static && npm test && npm run test:behavior && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "driver.js": "^1.8.0",
    "html2canvas": "^1.4.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.5.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.7"
  }
}
