{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YuanHub Operator Exchange v2 Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "exported_at", "producer", "records"],
  "properties": {
    "format": { "const": "myshare-operator-exchange" },
    "version": { "const": 2 },
    "exported_at": { "type": "string", "format": "date-time" },
    "catalog_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "producer": { "$ref": "#/$defs/producer" },
    "accounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/account" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "accountId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/accountId" },
        "name": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "record_id", "record_type", "game", "effective_at", "snapshot_scope", "entries"],
      "properties": {
        "account_id": { "$ref": "#/$defs/accountId" },
        "record_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "record_type": { "const": "operator_snapshot" },
        "game": { "enum": ["代号鸢", "如鸢"] },
        "effective_at": { "type": "string", "format": "date-time" },
        "snapshot_scope": { "enum": ["full", "listed"] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      },
      "allOf": [
        {
          "if": { "properties": { "snapshot_scope": { "const": "listed" } } },
          "then": { "properties": { "entries": { "minItems": 1 } } }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "elite", "starLevel", "level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "alias": { "type": "string" },
        "rarity": { "type": "integer" },
        "prof": { "type": "array", "items": { "type": "string" } },
        "subProf": { "type": "array", "items": { "type": "string" } },
        "games": { "type": "array", "items": { "type": "string" } },
        "elite": { "type": "integer", "minimum": 0 },
        "starLevel": { "type": "integer", "minimum": 0, "maximum": 31 },
        "level": { "type": "integer", "minimum": 0 },
        "discs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ot_name"],
            "properties": {
              "ot_name": { "type": "string" },
              "abbreviation": { "type": "string" },
              "color": { "type": "string" },
              "desp": { "type": "string" }
            }
          }
        },
        "starStones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "level"],
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["main", "assist", "main1", "main2", "main3", "assist1", "assist2", "assist3"] },
              "level": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
